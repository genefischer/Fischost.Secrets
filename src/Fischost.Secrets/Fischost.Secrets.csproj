<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Fischost.Secrets</PackageId>
    <RootNamespace>Fischost.Secrets</RootNamespace>
    <AssemblyName>Fischost.Secrets</AssemblyName>
    <Description>Loads an app's own secrets from Azure Key Vault by exact name, from an explicit map, into IConfiguration. Never lists the vault, never logs a value, fails fast in Production when a required secret is missing.</Description>
    <PackageTags>azure;keyvault;secrets;configuration</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <InternalsVisibleTo Include="Fischost.Secrets.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
